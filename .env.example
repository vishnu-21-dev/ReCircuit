# Backend environment (server.js). Copy to .env locally, or set these in Render.

# --- AI (required for listing/search/price/compat/vision features) ---
# Primary provider. Get a key at https://console.groq.com/keys
GROQ_KEY=
# Optional fallback provider, used automatically if Groq fails. https://aistudio.google.com/apikey
GEMINI_KEY=

# Optional: override model lists (comma-separated, tried in order)
# GROQ_TEXT_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-4-maverick-17b-128e-instruct
# GEMINI_MODELS=gemini-2.0-flash,gemini-2.5-flash

# --- Firebase Admin ---
# Either upload serviceAccountKey.json (Render secret file / project root) or paste the JSON here.
SERVICE_ACCOUNT_KEY=

# --- CORS / server ---
# Comma-separated deployed frontend origins (*.vercel.app is already allowed)
FRONTEND_URL=
PORT=5000

# Frontend (set in Vercel / frontend/.env): full URL of the deployed backend, e.g. https://your-api.onrender.com/api
# VITE_API_URL=
